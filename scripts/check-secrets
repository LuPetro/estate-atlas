#!/usr/bin/env bash
# Official Gitleaks CLI, pinned by SHA-256. No third-party action or licence key.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"
tool_dir="$root/.local/gitleaks"
mkdir -p "$tool_dir"
archive="$tool_dir/gitleaks_8.30.1_linux_x64.tar.gz"
if [[ ! -f "$archive" ]]; then
  curl --fail --location --silent --show-error --connect-timeout 15 --max-time 60 \
    https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz \
    -o "$archive.tmp"
  mv "$archive.tmp" "$archive"
fi
printf '%s  %s\n' 551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb "$archive" | sha256sum --check
tar -xzf "$archive" -C "$tool_dir" gitleaks
"$tool_dir/gitleaks" git --redact=100 --no-banner --log-opts="--all" \
  --report-format=json --report-path="$tool_dir/report.json" .

#!/usr/bin/env bash
set -Eeuo pipefail
source_root="$(cd "$(dirname "$0")/.." && pwd)"
operations_root="${EA_OPERATIONS_ROOT:-$source_root}"
export PATH="$operations_root/.local/node/bin:$PATH"
export DOCKER_CONFIG="$operations_root/.local/docker/cli"
export EA_GATEWAY_DIR="$operations_root/.local/gateway"
gateway=(docker compose --project-directory "$source_root" --env-file "$EA_GATEWAY_DIR/compose.env" -f "$source_root/compose.gateway.yaml")
case "${1:-}" in
  up)
    install -m 644 "$source_root/config/Caddyfile.gateway" "$EA_GATEWAY_DIR/config/Caddyfile"
    "${gateway[@]}" up -d --wait
    "${gateway[@]}" exec -T gateway caddy reload --config /etc/estateatlas/Caddyfile --adapter caddyfile
    ;;
  enable-production)
    # The production deploy script calls this only after the full release preflight.
    [[ "${EA_ENVIRONMENT:-}" == production ]] || { echo 'Production context required.'; exit 1; }
    install -m 644 "$source_root/config/Caddyfile.production" "$EA_GATEWAY_DIR/config/production.caddy"
    "${gateway[@]}" exec -T gateway caddy reload --config /etc/estateatlas/Caddyfile --adapter caddyfile
    ;;
  *) exec "${gateway[@]}" "$@" ;;
esac

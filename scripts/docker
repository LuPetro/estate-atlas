#!/usr/bin/env bash
set -euo pipefail
TASK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export EA_OPERATIONS_ROOT="${EA_OPERATIONS_ROOT:-$TASK_ROOT}"
export EA_ENVIRONMENT="${EA_ENVIRONMENT:-local}"
export PATH="$EA_OPERATIONS_ROOT/.local/node/bin:$PATH"
export DOCKER_CONFIG="$EA_OPERATIONS_ROOT/.local/docker/cli"
export COMPOSE_PARALLEL_LIMIT=1
case "$EA_ENVIRONMENT" in
  local) TASK_STATE="$EA_OPERATIONS_ROOT/.local" ;;
  development|production) TASK_STATE="$EA_OPERATIONS_ROOT/.local/environments/$EA_ENVIRONMENT" ;;
  *) echo 'Invalid EA_ENVIRONMENT.'; exit 1 ;;
esac
export EA_DOCKER_DIR="$TASK_STATE/docker"
export EA_BACKUP_DIR="$TASK_STATE/backups/automatic"
node "$TASK_ROOT/scripts/docker-init.mjs"
cd "$TASK_ROOT"
TASK_COMPOSE=(docker compose --project-directory "$TASK_ROOT" --env-file "$EA_DOCKER_DIR/compose.env" --env-file "$EA_DOCKER_DIR/backup-user.env" -f "$TASK_ROOT/compose.yaml")
if [[ "$EA_ENVIRONMENT" != local ]]; then
  TASK_COMPOSE+=(--project-name "estate-atlas-$EA_ENVIRONMENT" -f "$TASK_ROOT/compose.environment.yaml")
fi
TASK_PUBLIC=false
TASK_UP=false
for TASK_ARG in "$@"; do
  [[ "$TASK_ARG" == public || "$TASK_ARG" == edge ]] && TASK_PUBLIC=true
  [[ "$TASK_ARG" == up ]] && TASK_UP=true
done
if [[ "$EA_ENVIRONMENT" == local && "$TASK_UP" == true && -f "$EA_OPERATIONS_ROOT/.local/environments/development/legacy-adopted" ]]; then
  echo 'The legacy stack is retired. Use EA_ENVIRONMENT=development (or production); never start two databases on the adopted volume.' >&2
  exit 1
fi
if [[ "$TASK_PUBLIC" == true && "$TASK_UP" == true ]]; then
  [[ "$EA_ENVIRONMENT" == local ]] || { echo 'Use scripts/gateway for environment HTTPS.'; exit 1; }
  node "$TASK_ROOT/scripts/production-check.mjs"
fi
# BuildKit can build multiple images in parallel even with Compose concurrency=1.
# Serialize our two image targets on this 1.8 GB VPS. Other commands pass through.
if [[ "${1:-}" == build ]]; then
  shift
  TASK_FLAGS=()
  TASK_TARGETS=()
  for TASK_ARG in "$@"; do
    case "$TASK_ARG" in
      api|web|mobile) TASK_TARGETS+=("$TASK_ARG") ;;
      *) TASK_FLAGS+=("$TASK_ARG") ;;
    esac
  done
  if (( ${#TASK_TARGETS[@]} == 0 )); then TASK_TARGETS=(api web); fi
  for TASK_TARGET in "${TASK_TARGETS[@]}"; do
    "${TASK_COMPOSE[@]}" build "${TASK_FLAGS[@]}" "$TASK_TARGET"
  done
  exit 0
fi
if [[ "$TASK_UP" == true ]]; then
  TASK_UP_ARGS=()
  TASK_BUILD=false
  for TASK_ARG in "$@"; do
    if [[ "$TASK_ARG" == --build ]]; then TASK_BUILD=true; else TASK_UP_ARGS+=("$TASK_ARG"); fi
  done
  if [[ "$TASK_BUILD" == true ]]; then
    "$TASK_ROOT/scripts/docker" build api web
    exec "${TASK_COMPOSE[@]}" "${TASK_UP_ARGS[@]}"
  fi
fi
exec "${TASK_COMPOSE[@]}" "$@"

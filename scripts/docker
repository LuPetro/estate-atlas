#!/usr/bin/env bash
set -euo pipefail
TASK_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export PATH="$TASK_ROOT/.local/node/bin:$PATH"
export DOCKER_CONFIG="$TASK_ROOT/.local/docker/cli"
export COMPOSE_PARALLEL_LIMIT=1
node "$TASK_ROOT/scripts/docker-init.mjs"
cd "$TASK_ROOT"
TASK_COMPOSE=(docker compose --project-directory "$TASK_ROOT" --env-file "$TASK_ROOT/.local/docker/compose.env" --env-file "$TASK_ROOT/.local/docker/backup-user.env" -f "$TASK_ROOT/compose.yaml")
TASK_PUBLIC=false
TASK_UP=false
for TASK_ARG in "$@"; do
  [[ "$TASK_ARG" == public || "$TASK_ARG" == edge ]] && TASK_PUBLIC=true
  [[ "$TASK_ARG" == up ]] && TASK_UP=true
done
if [[ "$TASK_PUBLIC" == true && "$TASK_UP" == true ]]; then
  node "$TASK_ROOT/scripts/production-check.mjs"
fi
# BuildKit can build multiple images in parallel even with Compose concurrency=1.
# Serialize our two image targets on this 1.8 GB VPS. Other commands pass through.
if [[ "${1:-}" == build ]]; then
  shift
  TASK_FLAGS=()
  TASK_TARGETS=()
  for TASK_ARG in "$@"; do
    case "$TASK_ARG" in
      api|web|mobile) TASK_TARGETS+=("$TASK_ARG") ;;
      *) TASK_FLAGS+=("$TASK_ARG") ;;
    esac
  done
  if (( ${#TASK_TARGETS[@]} == 0 )); then TASK_TARGETS=(api web); fi
  for TASK_TARGET in "${TASK_TARGETS[@]}"; do
    "${TASK_COMPOSE[@]}" build "${TASK_FLAGS[@]}" "$TASK_TARGET"
  done
  exit 0
fi
if [[ "$TASK_UP" == true ]]; then
  TASK_UP_ARGS=()
  TASK_BUILD=false
  for TASK_ARG in "$@"; do
    if [[ "$TASK_ARG" == --build ]]; then TASK_BUILD=true; else TASK_UP_ARGS+=("$TASK_ARG"); fi
  done
  if [[ "$TASK_BUILD" == true ]]; then
    "$TASK_ROOT/scripts/docker" build api web
    exec "${TASK_COMPOSE[@]}" "${TASK_UP_ARGS[@]}"
  fi
fi
exec "${TASK_COMPOSE[@]}" "$@"

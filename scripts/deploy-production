#!/usr/bin/env bash
# Sent over SSH from the approved workflow checkout; never downloads remote shell code.
set -Eeuo pipefail
umask 077
export GIT_TERMINAL_PROMPT=0
: "${DEPLOY_PATH:?DEPLOY_PATH is required}"
: "${RELEASE_SHA:?RELEASE_SHA is required}"
[[ "$RELEASE_SHA" =~ ^[0-9a-f]{40}$ ]] || { echo 'Release SHA is invalid.'; exit 1; }
[[ -d "$DEPLOY_PATH/.git" ]] || { echo 'Deployment checkout is missing.'; exit 1; }
cd "$DEPLOY_PATH"
export EA_OPERATIONS_ROOT="$DEPLOY_PATH"
export EA_ENVIRONMENT=production
export PATH="$DEPLOY_PATH/.local/node/bin:$PATH"
[[ "$(git rev-parse --show-toplevel)" == "$(pwd -P)" ]] || { echo 'Deployment path must be the repository root.'; exit 1; }
mkdir -p .local/deploy
exec 9>.local/deploy/lock
flock -n 9 || { echo 'Another server deployment is running.'; exit 1; }
[[ "$(git symbolic-ref --quiet --short HEAD)" == main ]] || { echo 'Server checkout must be on main.'; exit 1; }
origin="$(git remote get-url origin)"
[[ "$origin" == 'https://github.com/LuPetro/estate-atlas.git' || "$origin" == 'git@github.com:LuPetro/estate-atlas.git' ]] || { echo 'Unexpected Git origin; refusing deployment.'; exit 1; }
[[ -z "$(git status --porcelain --untracked-files=no)" ]] || { echo 'Tracked server changes exist; refusing to overwrite them.'; exit 1; }
git fetch --no-tags origin refs/heads/main
[[ "$(git rev-parse FETCH_HEAD)" == "$RELEASE_SHA" ]] || { echo 'main moved after approval; approve its latest verified commit.'; exit 1; }
git merge-base --is-ancestor HEAD "$RELEASE_SHA" || { echo 'Server checkout contains unpublished commits; refusing deployment.'; exit 1; }
previous_sha="$(git rev-parse HEAD)"
phase=source
result=failed
record_result() {
  printf '{"commit":"%s","previousCommit":"%s","phase":"%s","result":"%s","at":"%s"}\n' \
    "$RELEASE_SHA" "$previous_sha" "$phase" "$result" "$(date -u +%FT%TZ)" > .local/deploy/last-release.json.tmp
  mv .local/deploy/last-release.json.tmp .local/deploy/last-release.json
}
trap record_result EXIT
# Fast-forward preserves unpublished commits and refuses conflicting untracked files.
git merge --ff-only "$RELEASE_SHA"
phase=preflight
node scripts/promote-images.mjs
node scripts/production-check.mjs
phase=containers
docker volume inspect estate-atlas-production_postgres_data >/dev/null 2>&1 || docker volume create estate-atlas-production_postgres_data >/dev/null
./scripts/docker up -d --no-build --wait
./scripts/gateway enable-production
phase=https
node scripts/production-check.mjs --live
phase=complete
result=success

# Docker defaults and secrets are generated by ./scripts/docker in .local/docker/.
# This file documents toolchain/mobile and legacy migration-source variables.
DATABASE_URL=postgresql://estateatlas:replace-with-random-password@127.0.0.1:55432/estateatlas
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Optional: replace with another Photon-compatible service or your own instance.
GEOCODING_URL=https://photon.komoot.io/api/
# Optional: public, website-restricted CARTO Basemaps key for Positron tiles.
# Overview uses local Natural Earth polygons; detail mode uses OSM if empty. Rebuild after changing.
NEXT_PUBLIC_CARTO_MAPS_KEY=

# Account/admin settings for Docker belong in .local/docker/compose.env.
# SMTP password and MFA encryption key are Docker secrets; see docs/accounts-admin.md.
ACCOUNT_PUBLIC_URL=http://localhost:3000
ACCOUNT_REQUIRE_VERIFICATION=false
REGISTRATION_MODE=invite

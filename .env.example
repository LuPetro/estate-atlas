# Generate a project-local development environment with ./scripts/pnpm db:start.
DATABASE_URL=postgresql://estateatlas:replace-with-random-password@127.0.0.1:55432/estateatlas
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Optional: replace with another Photon-compatible service or your own instance.
GEOCODING_URL=https://photon.komoot.io/api/
# Optional: public, website-restricted CARTO Basemaps key for Positron tiles.
# Leave empty to use the local light theme with OpenStreetMap. Rebuild after changing.
NEXT_PUBLIC_CARTO_MAPS_KEY=

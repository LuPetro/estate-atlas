# Copy the VALUES into .local/docker/compose.env, preserving existing secrets.
# PUBLIC_DOMAIN is the canonical app domain, without scheme/path (e.g. app.your-domain.tld).
PUBLIC_DOMAIN=
ACME_EMAIL=
OPS_ALERT_EMAIL=
WEB_ORIGIN=https://app.your-domain.tld
ACCOUNT_PUBLIC_URL=https://app.your-domain.tld
NEXT_PUBLIC_API_URL=/api
EXPO_PUBLIC_API_URL=https://app.your-domain.tld/api
ALLOW_LOCAL_HTTP=false
TRUST_PROXY=1
REGISTRATION_MODE=invite
ACCOUNT_REQUIRE_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_SECURE=false
SMTP_ALLOW_INSECURE=false
MAX_PROPERTIES_PER_ACCOUNT=100
MAX_ACCOUNT_STORAGE_MB=250
MAX_TOTAL_STORAGE_MB=2048
AUDIT_RETENTION_DAYS=180
# Keep user-started research bounded when admitting beta users. Never paid retries.
ANALYSIS_USER_DAILY_LIMIT=5
ANALYSIS_GLOBAL_DAILY_LIMIT=20
# Set only after the actual checks/copy described in docs/web-launch.md.
OFFSITE_BACKUP_CONFIRMED=false
SMTP_DELIVERY_CONFIRMED=false
UPTIME_MONITOR_CONFIRMED=false
